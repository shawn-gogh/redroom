# ─── Redroom Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit a populated .env file to version control.
#
# Variables prefixed with VITE_ are bundled into the client-side JavaScript
# and are visible to end users. Do NOT place private secrets in VITE_ variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://redroom:your_password@localhost:3306/redroom

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ── CMS Super-Admin ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY=replace_with_a_strong_random_secret

# ── OAuth (User Authentication) ───────────────────────────────────────────────
VITE_APP_ID=your_oauth_app_id
OAUTH_SERVER_URL=https://your-oauth-provider.example.com
VITE_OAUTH_PORTAL_URL=https://your-oauth-login-portal.example.com

# ── LLM / AI Service — any OpenAI-compatible endpoint ─────────────────────────
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini

# ── Object Storage — direct S3 (or S3-compatible: R2, MinIO, B2, ...) ────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_bucket_name
# Only set S3_ENDPOINT for S3-compatible providers other than AWS.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Only set S3_PUBLIC_BASE_URL if you serve uploads through a CDN/custom domain.
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# ── Google Maps (Client-side) ─────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── AIS Vessel Tracking ───────────────────────────────────────────────────────
AIS_API_KEY=your_ais_api_key

# ── Application Metadata ──────────────────────────────────────────────────────
VITE_APP_TITLE=Redroom
VITE_APP_LOGO=https://redroom.live/logo.png

# ── Owner Identity (for system notifications) ─────────────────────────────────
OWNER_OPEN_ID=your_oauth_open_id
OWNER_NAME=Your Name

# ── Analytics (optional) ──────────────────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=https://your-analytics.example.com/api/send
VITE_ANALYTICS_WEBSITE_ID=your_analytics_website_id
